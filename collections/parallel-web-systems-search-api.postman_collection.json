  "item": [
    {
      "id": "d61aba09-4feb-47ba-a6e5-59216971ca00",
      "name": "Search",
      "description": {
        "content": "Search returns ranked URLs with extended excerpts suitable for LLM consumption. Inputs are a natural-language objective and optional keyword queries. Source policies allow including or excluding specific domains and have configurable output sizes. The returned extended snippets contain dense, relevant information from relevant pages.\n- Result: ranked list with URL, title, and long text excerpts",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "76bcdee3-0b39-40de-844b-95a5fb91426b",
          "name": "Search",
          "request": {
            "name": "Search",
            "description": {
